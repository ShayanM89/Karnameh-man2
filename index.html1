<!DOCTYPE html> <html lang="fa" dir="rtl"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title>MASTER 20</title> <link rel="stylesheet" href="style.css"> </head> <body> <h1>MASTER 20 🏆</h1> <p>رقابت برای رسیدن به ۲۰</p> <!-- ============================= --> <!-- دکمه ثبت نمره --> <!-- ============================= --> <button id="scoreButton"> ثبت یک نمره ۲۰ 🏆 </button> <!-- ============================= --> <!-- انتخاب دانش‌آموز --> <!-- ============================= --> <div id="playerSelection"> <h2>این نمره برای چه کسی است؟</h2> <button class="playerButton" data-player="shayan"> 👤 شایان محمدی <span>انیشتین</span> </button> <button class="playerButton" data-player="pishro"> 👤 پیشرو رستاد <span>پاسکال</span> </button> </div> <!-- ============================= --> <!-- انتخاب عکس --> <!-- ============================= --> <input type="file" id="scoreImage" accept="image/*" > <!-- نمایش عکس --> <img id="previewImage"> <!-- ============================= --> <!-- دکمه تأیید --> <!-- ============================= --> <button id="verifyButton"> ارسال برای تأیید ✅ </button> <!-- پیام وضعیت --> <p id="statusMessage"></p> <!-- ============================= --> <!-- جدول MASTER 20 --> <!-- ============================= --> <h2>🏆 جدول MASTER 20</h2> <table> <thead> <tr> <th>نام</th> <th>لقب</th> <th>تعداد ۲۰</th> </tr> </thead> <tbody> <tr> <td>شایان محمدی</td> <td>انیشتین</td> <td id="shayanScore">۰</td> </tr> <tr> <td>پیشرو رستاد</td> <td>پاسکال</td> <td id="pishroScore">۰</td> </tr> </tbody> </table> <!-- JavaScript --> <script src="script.js"></script> </body> </html>